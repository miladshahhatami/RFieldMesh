  "variables": [
    {
      "correlation": {
        "model": "exponential",
        "scales": [
          10.0,
          10.0,
          4.0
        ]
      },
      "distribution": "lognormal",
      "moments": {
        "mean": 20000000.0,
        "standard_deviation": 6000000.0,
        "unit_label": "Pa"
      },
      "property_kind": "elastic_modulus"
    },
    {
      "correlation": {"model": "exponential", "scales": [10.0, 10.0, 4.0]},
      "distribution": "lognormal",
      "moments": {"mean": 1950.0, "standard_deviation": 97.5, "unit_label": "kg/m^3"},
