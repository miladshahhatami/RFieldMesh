{
  "algorithm": "covariance_kl",
  "covariance_kl": {
    "eigenvalue_tolerance": 1e-10,
    "dense_memory_limit_mb": 256.0,
    "iterative_memory_limit_mb": 1024.0,
    "iterative_max_modes": 512,
    "normalize_point_variance": true,
    "retained_variance": 0.95
  },
  "first_seed": 1403,
  "mapping": "centroid_sample",
  "name_prefix": "RFM",
  "output_path": "C:/replace/generated_3d.inp",
  "overwrite": false,
  "part_name": "Layered Soil Quarter",
  "realization_index": 0,
  "seed_strategy": "linear",
